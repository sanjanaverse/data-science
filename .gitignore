# Virtual environment (recreate it with: pip install -r requirements.txt)
.venv/

# Python cache files
__pycache__/

# Jupyter autosave files
.ipynb_checkpoints/

# Raw data in every project: too big for git, and anyone can re-download it
**/data/raw/

# CSV files inside any raw data folder (backup rule in case the one above is changed)
**/data/raw/**/*.csv

# Trained model files: they can be large and are recreated by running the notebooks
**/models/*.joblib
